Project:
  Name: CoilMaster
  Status: Development

Repository:
  Name: FantomeKGZ/CoilMaster
  SourceBranch: cmp-protocol-v1
  MainIsSource: false

Hardware:
  Arduino:
    Board: Arduino UNO R3
    Role: Realtime Controller
  ESP32:
    Board: ESP32 DevKit V1
    Flash: 4MB
    PSRAM: false
    Role: Service Controller

ProductionSources:
  ArduinoMain: firmware/arduino/src/main.cpp
  ArduinoModules: Arduino
  RealtimeCore: Core
  ESP32: firmware/esp32/src
  Web: firmware/esp32/web
  Handoff: docs/PROJECT_HANDOFF

Protocol:
  Active: CMP1 text UART
  Arduino: Arduino/CM_UartEventTransport.cpp
  ESP32: firmware/esp32/src/CM_UartEventReceiver.cpp
  BinarySharedStatus: host-tests-only

Safety:
  AutomaticPhysicalStart: false
  AutoResumeAfterReboot: false
  Esp32DirectSsrControl: false
  AutomaticWireWriteoff: false
  ExactWriteoffProvenance: true

Storage:
  SDCard: true
  DataRoot: /data
  WebRoot: /web

Network:
  WiFi: true
  HTTP: true
  FTP: true
  OTA: false

License:
  Type: Proprietary
